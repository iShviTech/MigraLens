# Required: origin to crawl and audit.
TARGET_URL=https://example.com

# Root folder for date-stamped run artifacts.
OUTPUT_DIR=./reports

# Playwright crawler + axe-core limits.
MAX_CRAWL_DEPTH=3
MAX_URLS=50
PLAYWRIGHT_HEADLESS=true

# Crawl link filters (false = skip / count in crawl-meta; true = include).
# CRAWL_EXTERNAL_LINKS — off-origin http(s) pages
# CRAWL_NON_HTTP_LINKS — mailto:/tel:/javascript:/ftp: (inventory only, not navigated)
# CRAWL_DOCUMENT_LINKS — pdf/doc/xls/ppt/zip
CRAWL_EXTERNAL_LINKS=false
CRAWL_NON_HTTP_LINKS=false
CRAWL_DOCUMENT_LINKS=false

# Performance engine: lighthouse (local MCP) | pagespeed (Google PageSpeed Insights API).
# Freeze this across WordPress → Drupal baselines so score deltas stay comparable.
# pagespeed keeps the full Lighthouse result, which the summary report needs for the
# Lighthouse accessibility audits and the downloadable official reports.
PERF_PROVIDER=pagespeed

# PERF_PROVIDER=lighthouse engine: cli = full local Lighthouse with installed Chrome (accessibility audits +
# official reports; set CHROME_PATH if Chrome is elsewhere), mcp = Lighthouse MCP (scores only).
LIGHTHOUSE_ENGINE=cli
# Local Lighthouse MCP (used when LIGHTHOUSE_ENGINE=mcp). Accessibility uses axe-core + Playwright.
LIGHTHOUSE_MCP_CMD=npx -y lighthouse-mcp

# Required when PERF_PROVIDER=pagespeed. Create a key in Google Cloud Console and enable the
# "PageSpeed Insights API" for that project (otherwise calls fail with PERMISSION_DENIED).
PAGESPEED_API_KEY=

# Parallel audit workers (shared Playwright browser for a11y; each Lighthouse slot starts its own MCP process).
CONCURRENCY_LIMIT=2

# --- Optional tuning ---
# MAX_URLS=                # omit or leave empty for no cap
INCLUDE_QUERY_PARAMS=false
CRAWL_TIMEOUT_MS=30000
AUDIT_TIMEOUT_MS=180000
NAVIGATION_RETRIES=3
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1500
USER_AGENT=

# Lighthouse MCP tool name if your server uses a non-default name.
LIGHTHOUSE_MCP_TOOL=run_audit

# Device / category options (apply to both lighthouse and pagespeed).
# Every URL is audited once per device in LIGHTHOUSE_DEVICES (each device is one more API call per URL).
LIGHTHOUSE_DEVICES=mobile,desktop
# Primary device: the summary's default view and the copy kept at lighthouse/consolidated.json for comparisons.
LIGHTHOUSE_DEVICE=desktop
LIGHTHOUSE_THROTTLING=true
LIGHTHOUSE_CATEGORIES=performance,accessibility,best-practices,seo

# Compare defaults (can also pass --from / --to CLI flags).
COMPARE_FROM=
COMPARE_TO=

# Reuse an existing run folder instead of creating a new timestamp.
# Example: 2026-09-20/143052
RUN_ID=

# --- Live vs Stage content compare (`npm run content-compare`) ---
# Same URL paths on both hosts. Do not commit real passwords.
# READ-ONLY: do not edit any site content. The compare only reads pages.
# Live is a public website. It never uses login or credentials.
LIVE_URL=https://example.com
STAGE_URL=https://stage.example.com

# Stage layer 1: HTTP Basic Auth (browser popup). Optional.
# true = send basic auth; false = skip this layer (credentials ignored).
STAGE_BASIC_AUTH=false
STAGE_BASIC_USER=
STAGE_BASIC_PASS=

# Stage layer 2: Drupal member login. Optional.
# true = log in at STAGE_LOGIN_PATH; false = skip this layer (credentials ignored).
STAGE_DRUPAL_LOGIN=false
STAGE_LOGIN_PATH=/member/login
STAGE_DRUPAL_USER=
STAGE_DRUPAL_PASS=

# Optional: comma-separated paths to check (e.g. /,/services). Empty = use reports/url/urls-flat.json.
COMPARE_PATHS=/,/services

# Main-content root compared on each side. Empty = main, [role=main], #main-content, #main,
# .site-main, #content, else body without header/nav/footer/aside.
LIVE_MAIN_SELECTOR=
STAGE_MAIN_SELECTOR=

# Header / footer compare. true = compare and include in the verdict (a mismatch fails the page);
# false = skip (column shows "Not checked"). Re-run content-compare:analyze to apply to an existing run.
COMPARE_HEADER=true
COMPARE_FOOTER=true
# Site header / footer root on each side. Empty = header / [role=banner] and footer / [role=contentinfo].
LIVE_HEADER_SELECTOR=
STAGE_HEADER_SELECTOR=
LIVE_FOOTER_SELECTOR=
STAGE_FOOTER_SELECTOR=

# Extra popup DISMISS controls (comma-separated CSS). Never list a button that navigates away.
# Built-in defaults already close GTranslate geo popups (a[class*="redirectpopup"][class$="_closetext"],
# the "NO - STAY ON THE CANADA WEBSITE" link), OneTrust / CookieYes / Cookiebot banners, and common modals.
LIVE_POPUP_CLOSE_SELECTORS=
STAGE_POPUP_CLOSE_SELECTORS=

# Max dHash Hamming distance (0-64) for two images to count as the same picture. Lower = stricter.
IMAGE_HASH_THRESHOLD=10

# Content-compare speed.
# Pages compared at the same time (each worker loads live and stage together). Shares one stage login.
COMPARE_CONCURRENCY=4
# Max wait (ms) for network idle after each page load. Pages with live analytics rarely go idle.
COMPARE_IDLE_MS=5000
# Hosts aborted for non-image requests (analytics, ads, video embeds). Empty = built-in list,
# "none" = block nothing, or a comma-separated list that replaces the built-in one.
COMPARE_BLOCK_HOSTS=
# true = also save full-page live/stage JPEGs on FAIL. Element crops are always saved.
COMPARE_FULL_SCREENSHOTS=false
# Existing run folder to finish (e.g. reports/content-compare/2026-10-02/161652).
# Skips paths that already have a by-path record; ERROR records are retried.
COMPARE_RESUME=

# Redirect check (Redirect column). Stage is opened at the old live path; it must answer with
# permanent redirects to a 200 page on the stage host (not home or login). No redirect = N/A.
# Allowed hop status codes (comma-separated).
REDIRECT_ALLOWED_STATUS=301,308
# Max redirect hops before the chain fails.
REDIRECT_MAX_HOPS=3
# Optional regex: paths that must redirect on stage (e.g. ^/article/). Empty = redirect optional.
REDIRECT_REQUIRED_PATTERN=

# --- Smart match, issue grouping, AI review (`npm run content-compare:analyze -- <run-dir>`) ---
# Runs automatically at the end of `npm run content-compare`; re-run it any time without crawling.
# Token similarity (0-1) at which a missing/extra text pair is reported as "Reworded" instead of
# two unrelated blocks. Reworded text still fails; punctuation/spacing/split-only text passes.
CONTENT_REWORD_THRESHOLD=0.8
# An issue group on at least this % of pages is "global" and reported once in issues.html.
ISSUE_GLOBAL_PCT=80

# Optional AI review of leftover content/image mismatches: none | ollama | gemini.
# ollama = free and local (brew install ollama && ollama pull qwen2.5:7b); nothing leaves your machine.
# gemini = free tier with rate limits; key from https://aistudio.google.com/apikey. Page text and images are sent to Google.
# AI can only mark a column "Yes (AI)" (verdict "PASS (AI-verified)"); the strict result stays in diff.strict.
AI_PROVIDER=none
# Empty = qwen2.5:7b (ollama) or gemini-2.5-flash (gemini).
AI_MODEL=
OLLAMA_URL=http://localhost:11434
GEMINI_API_KEY=
# Ollama vision model for image review (e.g. qwen2.5vl:7b). Empty = image review off for ollama.
AI_VISION_MODEL=
# false = review text only.
AI_IMAGES=true
# Minimum AI confidence (0-1) to accept "same content". Lower = more AI-verified passes, more risk.
AI_MIN_CONFIDENCE=0.85
# Parallel AI requests. Empty = 1 for ollama, 2 for gemini.
AI_CONCURRENCY=
# Max pages sent to AI per analyze run (0 = all). Answers are cached in reports/content-compare/.ai-cache.json.
AI_MAX_PAGES=0
