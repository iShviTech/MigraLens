# Required: origin to crawl and audit.
TARGET_URL=https://example.com

# Root folder for date-stamped run artifacts.
OUTPUT_DIR=./reports

# Playwright crawler + axe-core limits.
MAX_CRAWL_DEPTH=3
MAX_URLS=50
PLAYWRIGHT_HEADLESS=true

# Crawl link filters (false = skip / count in crawl-meta; true = include).
# CRAWL_EXTERNAL_LINKS — off-origin http(s) pages
# CRAWL_NON_HTTP_LINKS — mailto:/tel:/javascript:/ftp: (inventory only, not navigated)
# CRAWL_DOCUMENT_LINKS — pdf/doc/xls/ppt/zip
CRAWL_EXTERNAL_LINKS=false
CRAWL_NON_HTTP_LINKS=false
CRAWL_DOCUMENT_LINKS=false

# Performance engine: lighthouse (local MCP) | pagespeed (Google PageSpeed Insights API).
# Freeze this across WordPress → Drupal baselines so score deltas stay comparable.
PERF_PROVIDER=lighthouse

# Local Lighthouse MCP (used when PERF_PROVIDER=lighthouse). Accessibility uses axe-core + Playwright.
LIGHTHOUSE_MCP_CMD=npx -y lighthouse-mcp

# Required when PERF_PROVIDER=pagespeed. Create a key in Google Cloud Console (PageSpeed Insights API).
PAGESPEED_API_KEY=

# Parallel audit workers (shared Playwright browser for a11y; each Lighthouse slot starts its own MCP process).
CONCURRENCY_LIMIT=2

# --- Optional tuning ---
# MAX_URLS=                # omit or leave empty for no cap
INCLUDE_QUERY_PARAMS=false
CRAWL_TIMEOUT_MS=30000
AUDIT_TIMEOUT_MS=180000
NAVIGATION_RETRIES=3
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1500
USER_AGENT=

# Lighthouse MCP tool name if your server uses a non-default name.
LIGHTHOUSE_MCP_TOOL=run_audit

# Device / category options (apply to both lighthouse and pagespeed).
LIGHTHOUSE_DEVICE=desktop
LIGHTHOUSE_THROTTLING=true
LIGHTHOUSE_CATEGORIES=performance,accessibility,best-practices,seo

# Compare defaults (can also pass --from / --to CLI flags).
COMPARE_FROM=
COMPARE_TO=

# Reuse an existing run folder instead of creating a new timestamp.
# Example: 2026-09-20/143052
RUN_ID=

# --- Live vs Stage content compare (`npm run content-compare`) ---
# Same URL paths on both hosts. Do not commit real passwords.
# READ-ONLY: do not edit any site content. The compare only reads pages.
# Live is a public website. It never uses login or credentials.
LIVE_URL=https://example.com
STAGE_URL=https://stage.example.com

# Stage layer 1: HTTP Basic Auth (browser popup). Optional.
# true = send basic auth; false = skip this layer (credentials ignored).
STAGE_BASIC_AUTH=false
STAGE_BASIC_USER=
STAGE_BASIC_PASS=

# Stage layer 2: Drupal member login. Optional.
# true = log in at STAGE_LOGIN_PATH; false = skip this layer (credentials ignored).
STAGE_DRUPAL_LOGIN=false
STAGE_LOGIN_PATH=/member/login
STAGE_DRUPAL_USER=
STAGE_DRUPAL_PASS=

# Optional: comma-separated paths to check (e.g. /,/services). Empty = use reports/url/urls-flat.json.
COMPARE_PATHS=/,/services

# Main-content root compared on each side. Empty = main, [role=main], #main-content, #main,
# .site-main, #content, else body without header/nav/footer/aside.
LIVE_MAIN_SELECTOR=
STAGE_MAIN_SELECTOR=

# Extra popup DISMISS controls (comma-separated CSS). Never list a button that navigates away.
# Built-in defaults already close GTranslate geo popups (a[class*="redirectpopup"][class$="_closetext"],
# the "NO - STAY ON THE CANADA WEBSITE" link), OneTrust / CookieYes / Cookiebot banners, and common modals.
LIVE_POPUP_CLOSE_SELECTORS=
STAGE_POPUP_CLOSE_SELECTORS=

# Max dHash Hamming distance (0-64) for two images to count as the same picture. Lower = stricter.
IMAGE_HASH_THRESHOLD=10

# Content-compare speed.
# Pages compared at the same time (each worker loads live and stage together). Shares one stage login.
COMPARE_CONCURRENCY=4
# Max wait (ms) for network idle after each page load. Pages with live analytics rarely go idle.
COMPARE_IDLE_MS=5000
# Hosts aborted for non-image requests (analytics, ads, video embeds). Empty = built-in list,
# "none" = block nothing, or a comma-separated list that replaces the built-in one.
COMPARE_BLOCK_HOSTS=
# true = also save full-page live/stage JPEGs on FAIL. Element crops are always saved.
COMPARE_FULL_SCREENSHOTS=false
# Existing run folder to finish (e.g. reports/content-compare/2026-10-02/161652).
# Skips paths that already have a by-path record; ERROR records are retried.
COMPARE_RESUME=
